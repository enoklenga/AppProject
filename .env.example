# Django development
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_PORT=8000
DJANGO_SESSION_COOKIE_NAME=lef_timesheet_sessionid
DJANGO_CSRF_COOKIE_NAME=lef_timesheet_csrftoken

# Upload/security web
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DOCUMENTS_MAX_UPLOAD_SIZE_MB=10
IMPORT_MAX_UPLOAD_SIZE_MB=5
WEB_LOGIN_RATE_LIMIT=5
WEB_LOGIN_IP_RATE_LIMIT=30
WEB_LOGIN_RATE_WINDOW_SECONDS=300

# PostgreSQL
POSTGRES_DB=lef_timesheet
POSTGRES_USER=lef_timesheet
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=timesheet@example.local
SITE_URL=http://localhost:8000

# API security
API_TOKEN_TTL_HOURS=720
API_TOKEN_TOUCH_INTERVAL_MINUTES=5
API_ROTATE_TOKEN_ON_LOGIN=False
WEB_REQUIRE_PASSWORD_CHANGED=False
API_REQUIRE_PASSWORD_CHANGED=False
API_ANON_THROTTLE_RATE=20/min
API_USER_BURST_THROTTLE_RATE=120/min
API_USER_SUSTAINED_THROTTLE_RATE=2000/day
API_LOGIN_THROTTLE_RATE=5/min
API_MUTATION_THROTTLE_RATE=240/hour
API_SENSITIVE_THROTTLE_RATE=30/hour
API_IMPORT_THROTTLE_RATE=20/hour
API_EXPORT_THROTTLE_RATE=120/hour
API_NUM_PROXIES=0
API_TRUST_X_FORWARDED_FOR=False
API_LOG_LEVEL=INFO
API_SECURITY_LOG_LEVEL=INFO
API_SECURITY_LOG_MUTATIONS=True

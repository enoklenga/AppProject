# PostgreSQL staging isolato
POSTGRES_DB=lef_timesheet_staging
POSTGRES_USER=lef_staging
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django staging
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SESSION_COOKIE_NAME=lef_timesheet_staging_sessionid
DJANGO_CSRF_COOKIE_NAME=lef_timesheet_staging_csrftoken
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DOCUMENTS_MAX_UPLOAD_SIZE_MB=10
IMPORT_MAX_UPLOAD_SIZE_MB=5
WEB_LOGIN_RATE_LIMIT=5
WEB_LOGIN_IP_RATE_LIMIT=30
WEB_LOGIN_RATE_WINDOW_SECONDS=300
SITE_URL=http://localhost:8081
STAGING_HTTP_PORT=8081
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Email di prova
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=timesheet-staging@example.local
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False

# API security
API_TOKEN_TTL_HOURS=720
API_TOKEN_TOUCH_INTERVAL_MINUTES=5
API_ROTATE_TOKEN_ON_LOGIN=False
WEB_REQUIRE_PASSWORD_CHANGED=True
API_REQUIRE_PASSWORD_CHANGED=True
API_ANON_THROTTLE_RATE=20/min
API_USER_BURST_THROTTLE_RATE=120/min
API_USER_SUSTAINED_THROTTLE_RATE=2000/day
API_LOGIN_THROTTLE_RATE=5/min
API_MUTATION_THROTTLE_RATE=240/hour
API_SENSITIVE_THROTTLE_RATE=30/hour
API_IMPORT_THROTTLE_RATE=20/hour
API_EXPORT_THROTTLE_RATE=120/hour
API_NUM_PROXIES=1
API_TRUST_X_FORWARDED_FOR=True
API_LOG_LEVEL=INFO
API_SECURITY_LOG_LEVEL=INFO
API_SECURITY_LOG_MUTATIONS=True

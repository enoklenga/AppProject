# PostgreSQL production
POSTGRES_DB=lef_timesheet_prod
POSTGRES_USER=lef_timesheet_prod
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=timesheet.example.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://timesheet.example.it
SITE_URL=https://timesheet.example.it
DJANGO_SESSION_COOKIE_NAME=lef_timesheet_sessionid
DJANGO_CSRF_COOKIE_NAME=lef_timesheet_csrftoken

# HTTPS/security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DOCUMENTS_MAX_UPLOAD_SIZE_MB=10
IMPORT_MAX_UPLOAD_SIZE_MB=5
WEB_LOGIN_RATE_LIMIT=5
WEB_LOGIN_IP_RATE_LIMIT=30
WEB_LOGIN_RATE_WINDOW_SECONDS=300

# Gunicorn / Nginx
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
HTTP_PORT=80

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=timesheet@example.it
EMAIL_HOST=smtp.example.it
EMAIL_PORT=587
EMAIL_HOST_USER=timesheet@example.it
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20

# API security
API_TOKEN_TTL_HOURS=720
API_TOKEN_TOUCH_INTERVAL_MINUTES=5
API_ROTATE_TOKEN_ON_LOGIN=False
WEB_REQUIRE_PASSWORD_CHANGED=True
API_REQUIRE_PASSWORD_CHANGED=True
API_ANON_THROTTLE_RATE=20/min
API_USER_BURST_THROTTLE_RATE=120/min
API_USER_SUSTAINED_THROTTLE_RATE=2000/day
API_LOGIN_THROTTLE_RATE=5/min
API_MUTATION_THROTTLE_RATE=240/hour
API_SENSITIVE_THROTTLE_RATE=30/hour
API_IMPORT_THROTTLE_RATE=20/hour
API_EXPORT_THROTTLE_RATE=120/hour
API_NUM_PROXIES=1
API_TRUST_X_FORWARDED_FOR=True
API_THROTTLE_CACHE_DIR=/tmp/lef-api-throttle-cache
API_LOG_LEVEL=INFO
API_SECURITY_LOG_LEVEL=INFO
API_SECURITY_LOG_MUTATIONS=True
